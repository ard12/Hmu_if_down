# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller / Executables
*.manifest
*.spec

# Model checkpoints / Weights / Large files
models/*.onnx
models/*.pt
models/*.pth
models/*.tflite
*.weights
*.h5

# Logs and incident reports
*.log
logs/
incidents/
output/
recordings/
datasets/*.npz
datasets/*.json
datasets/trials/*.npz
datasets/trials/*.json
!datasets/.gitkeep

# Audit database and FHIR exports (sensitive clinical data)
audits/audit.db
audits/fhir_export_*.json

# API Secrets — NEVER commit the actual token file
config/api_tokens.yaml

# Compiled firmware binaries (built from source)
deploy/firmware/*.bin
deploy/firmware/*.elf

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# Environments & IDEs
.env
.idea/
.vscode/
*.swp
*.swo

# OS generated
.DS_Store
Thumbs.db
desktop.ini
